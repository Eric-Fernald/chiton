# Normalise line endings so the shell shims and install scripts stay executable
# on POSIX hosts even when they are committed from Windows.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.exe binary
*.png binary
*.jpg binary
*.gif binary

# The shim in bin/ has no extension; make sure it is never CRLF-mangled.
bin/chiton text eol=lf
scripts/*.sh text eol=lf

# Keep generated/vendored noise out of language statistics and diffs.
go.sum linguist-generated=true
